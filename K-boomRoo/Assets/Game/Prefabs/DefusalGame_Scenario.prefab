  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=center><size=115%><b>ORDEN DE MISI\xD3N</b></size>\n<color=#881111><size=80%><b>DESACTIVACI\xD3N
    DE EMERGENCIA</b></size></color></align>\n-------------------------\n<size=85%>Bomba
    activa. Cruza la <b>puerta a tu izquierda</b> para buscar las 4 claves:\n\n<b>[
    ] 1. ESTUDIO:</b> Revisa cajones.\n<b>[ ] 2. PIZARRA:</b> Examina pizarra.\n<b>[
    ] 3. ARCHIVO:</b> Revisa libros.\n<b>[ ] 4. CAJA:</b> Revisa herramientas.\n\n<b>Progreso:
    0/4 pistas</b>\n-------------------------\n<i>Pulsa <b>ENT</b> tras ingresar
    el c\xF3digo.\nError: penaliza <b>-30s</b>.</i></size>"
