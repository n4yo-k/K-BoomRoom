  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><size=120%>PROTOCOLO SOBRECARGA // NIVEL 3</size></b>\n<size=80%><color=#8B0000>TIEMPO
    CR\xCDTICO: 03:30 MINUTOS</color></size>\n\n<b>1. SOBRETENSI\xD3N:</b>\n\u2022
    Dir\xEDgete a la <b>COCINA</b> y corta el disyuntor <b>B2</b> en el panel.\n\u2022
    Agarra el bloque de hielo con la mano y cali\xE9ntalo en el <b>MICROONDAS</b>
    (3s).\n\n<b>2. CORTE DE CABLE:</b>\n\u2022 Revisa la <b>TERMINAL PC</b>: indica
    cortar el <b>CABLE AZUL</b>.\n\u2022 \xA1Cualquier otro cable detonar\xE1 la
    bomba!\n\n<b>3. TECLADO Y C\xD3DIGO UV:</b>\n\u2022 En el <b>CUARTO</b>, agarra
    la linterna UV y presiona el gatillo.\n\u2022 Ilumina la pared para revelar el
    c\xF3digo e ingr\xE9salo en el teclado num\xE9rico."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
